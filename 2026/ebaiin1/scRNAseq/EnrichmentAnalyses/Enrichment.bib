@article{lauriaRiboWaltzOptimizationRibosome2018,
	title = {{riboWaltz}: {Optimization} of ribosome {P}-site positioning in ribosome profiling data},
	volume = {14},
	issn = {1553-7358},
	shorttitle = {{riboWaltz}},
	url = {https://journals.plos.org/ploscompbiol/article?id=10.1371/journal.pcbi.1006169},
	doi = {10.1371/journal.pcbi.1006169},
	abstract = {Ribosome profiling is a powerful technique used to study translation at the genome-wide level, generating unique information concerning ribosome positions along RNAs. Optimal localization of ribosomes requires the proper identification of the ribosome P-site in each ribosome protected fragment, a crucial step to determine the trinucleotide periodicity of translating ribosomes, and draw correct conclusions concerning where ribosomes are located. To determine the P-site within ribosome footprints at nucleotide resolution, the precise estimation of its offset with respect to the protected fragment is necessary. Here we present riboWaltz, an R package for calculation of optimal P-site offsets, diagnostic analysis and visual inspection of ribosome profiling data. Compared to existing tools, riboWaltz shows improved accuracies for P-site estimation and neat ribosome positioning in multiple case studies. riboWaltz was implemented in R and is available as an R package at https://github.com/LabTranslationalArchitectomics/RiboWaltz.},
	language = {en},
	number = {8},
	urldate = {2025-01-21},
	journal = {PLOS Computational Biology},
	publisher = {Public Library of Science},
	author = {Lauria, Fabio and Tebaldi, Toma and Bernabò, Paola and Groen, Ewout J. N. and Gillingwater, Thomas H. and Viero, Gabriella},
	month = aug,
	year = {2018},
	keywords = {Nucleotides, 3' UTR, 5' UTR, Plastids, Protein translation, Ribosomes, Translation initiation, Yeast},
	pages = {e1006169},
	file = {Full Text PDF:C\:\\Users\\margot.zahm\\Zotero\\storage\\C2FY4IS3\\Lauria et al. - 2018 - riboWaltz Optimization of ribosome P-site positioning in ribosome profiling data.pdf:application/pdf},
}

@article{brarRibosomeProfilingReveals2015,
	title = {Ribosome profiling reveals the what, when, where and how of protein synthesis},
	volume = {16},
	copyright = {2015 Springer Nature Limited},
	issn = {1471-0080},
	url = {https://www.nature.com/articles/nrm4069},
	doi = {10.1038/nrm4069},
	abstract = {Ribosome profiling is a deep-sequencing-based tool that allows the detailed measurement of translation globally and in vivo.The method provides quantification of levels of new protein synthesis, as well as information about ribosome positions that can be used to infer details about translation mechanism or to identify translated open reading frames (ORFs).Ribosome profiling enables instantaneous rather than steady-state measurement and is thus a particularly valuable tool for the study of gene expression over dynamic processes.Proximity-specific ribosome profiling is based on localized labelling of ribosome populations within cells and enables in vivo measurement of translation at specific organelles or subcellular structures.Ribosome profiling is the first tool available for the experimental annotation of translated ORFs and has enabled the discovery of a wide range of new translation products. These include novel short peptides and alternative isoforms of characterized proteins, the vast majority of which are currently of unknown function.},
	language = {en},
	number = {11},
	urldate = {2025-01-21},
	journal = {Nature Reviews Molecular Cell Biology},
	publisher = {Nature Publishing Group},
	author = {Brar, Gloria A. and Weissman, Jonathan S.},
	month = nov,
	year = {2015},
	keywords = {Proteomic analysis, Proteomics, Ribosome},
	pages = {651--664},
	file = {Full Text PDF:C\:\\Users\\margot.zahm\\Zotero\\storage\\ZJ6YGY8C\\Brar et Weissman - 2015 - Ribosome profiling reveals the what, when, where and how of protein synthesis.pdf:application/pdf},
}

