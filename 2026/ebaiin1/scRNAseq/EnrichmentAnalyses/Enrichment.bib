	keywords = {Software, RNA sequencing, Functional genomics, Machine learning},
	pages = {550--572},
	file = {Full Text PDF:C\:\\Users\\margot.zahm\\Zotero\\storage\\W4C6Y72L\\Heumos et al. - 2023 - Best practices for single-cell analysis across mod.pdf:application/pdf},
}

