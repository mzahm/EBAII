	pages = {20},
	file = {Full Text PDF:C\:\\Users\\margot.zahm\\Zotero\\storage\\3GWQEVKQ\\Schubert et al. - 2018 - Perturbation-response genes reveal signaling footp.pdf:application/pdf},
}

@article{badia-i-mompelDecoupleREnsembleComputational2022,
