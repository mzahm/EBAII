	keywords = {Animals, Genomics, Humans, Databases, Genetic, Genome, Software, Mice, Regulatory Elements, Transcriptional, Protein Binding, Chromatin Immunoprecipitation, Data Mining, E1A-Associated p300 Protein, Jurkat Cells, Serum Response Factor},
	pages = {495--501},
	file = {Version acceptée:C\:\\Users\\margot.zahm\\Zotero\\storage\\D9XEZDI6\\McLean et al. - 2010 - GREAT improves functional interpretation of cis-re.pdf:application/pdf},
}

@article{kitagawaGuidanceRegulatoryCell2017,
	title = {Guidance of regulatory {T} cell development by {Satb1}-dependent super-enhancer establishment},
	volume = {18},
	issn = {1529-2908},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5582804/},
	doi = {10.1038/ni.3646},
	abstract = {Most Foxp3+ regulatory T (Treg) cells develop in the thymus as a functionally mature T cell subpopulation specialized for immune suppression. Their cell fate appears to be determined before Foxp3 expression; yet molecular events that prime Foxp3− Treg precursor cells are largely obscure. We found that Treg cell–specific super-enhancers (Treg-SEs), which were associated with Foxp3 and other Treg cell signature genes, began to be activated in Treg precursor cells. T cell–specific deficiency of the genome organizer Satb1 impaired Treg-SE activation and the subsequent expression of Treg signature genes, causing severe autoimmunity due to Treg cell deficiency. These results suggest that Satb1-dependent Treg-SE activation is crucial for Treg cell lineage specification in the thymus and that its perturbation is causative of autoimmune and other immunological diseases.},
	number = {2},
	urldate = {2023-05-03},
	journal = {Nature immunology},
	author = {Kitagawa, Yohko and Ohkura, Naganari and Kidani, Yujiro and Vandenbon, Alexis and Hirota, Keiji and Kawakami, Ryoji and Yasuda, Keiko and Motooka, Daisuke and Nakamura, Shota and Kondo, Motonari and Taniuchi, Ichiro and Kohwi-Shigematsu, Terumi and Sakaguchi, Shimon},
	month = feb,
	year = {2017},
	pages = {173--183},
	file = {PubMed Central Full Text PDF:C\:\\Users\\margot.zahm\\Zotero\\storage\\BQGFQTQQ\\Kitagawa et al. - 2017 - Guidance of regulatory T cell development by Satb1.pdf:application/pdf},
}

