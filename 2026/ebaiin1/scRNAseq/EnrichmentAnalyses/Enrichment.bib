	pages = {iyae031},
	file = {Full Text PDF:C\:\\Users\\margot.zahm\\Zotero\\storage\\HU5DMFKT\\Baldarelli et al. - 2024 - Mouse Genome Informatics an integrated knowledgeb.pdf:application/pdf;Snapshot:C\:\\Users\\margot.zahm\\Zotero\\storage\\Z9JGVIN7\\7635261.html:text/html},
