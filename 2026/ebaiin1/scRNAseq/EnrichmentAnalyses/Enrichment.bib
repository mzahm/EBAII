	pages = {449--463},
	file = {PubMed Central Full Text PDF:C\:\\Users\\margot.zahm\\Zotero\\storage\\L6H42BPV\\Miraldi et al. - 2019 - Leveraging chromatin accessibility for transcripti.pdf:application/pdf},
